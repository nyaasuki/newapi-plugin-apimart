{
  "cases": [
    {
      "name": "submit maps to APIMart image generation with the upstream model",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "gpt-image-2.5-flare",
          "upstreamModel": "gpt-image-2.5-flare",
          "baseUrl": "https://api.apimart.ai",
          "apiKey": "example-key",
          "authHeader": "Bearer example-key",
          "upstream": { "kind": "vendor" },
          "requestBody": { "model": "gpt-image-2.5-flare", "prompt": "A quiet garden", "size": "1:1", "quality": "medium" }
        }
      ],
      "expected": {
        "url": "https://api.apimart.ai/v1/images/generations",
        "method": "POST",
        "headers": { "Authorization": "Bearer example-key", "Content-Type": "application/json", "Accept": "application/json" },
        "body": { "model": "gpt-image-2.5-flare", "prompt": "A quiet garden", "size": "1:1", "quality": "medium" }
      }
    },
    {
      "name": "reject an empty prompt",
      "hook": "buildSubmitRequest",
      "args": [{ "model": "gpt-image-2.5-flare", "upstreamModel": "gpt-image-2.5-flare", "baseUrl": "https://api.apimart.ai", "authHeader": "Bearer k", "requestBody": { "prompt": " " } }],
      "expectedError": "prompt is required"
    },
    {
      "name": "read the task id from data[0]",
      "hook": "parseSubmitResponse",
      "args": [{}, { "statusCode": 200, "headers": {}, "body": { "code": 200, "data": [{ "status": "submitted", "task_id": "task_01K" }] } }],
      "expected": { "taskId": "task_01K", "taskData": { "code": 200, "data": [{ "status": "submitted", "task_id": "task_01K" }] } }
    },
    {
      "name": "query the task endpoint",
      "hook": "buildQueryRequest",
      "args": [{ "taskId": "task_01K", "baseUrl": "https://api.apimart.ai", "authHeader": "Bearer k" }],
      "expected": { "url": "https://api.apimart.ai/v1/tasks/task_01K", "method": "GET", "headers": { "Authorization": "Bearer k", "Accept": "application/json" } }
    },
    {
      "name": "processing maps to in progress",
      "hook": "parseTaskResult",
      "args": [{}, { "code": 200, "data": { "status": "processing", "progress": 40 } }, { "status": 200, "headers": {} }],
      "expected": { "status": "IN_PROGRESS", "progress": "40%" }
    },
    {
      "name": "failed task carries the reason",
      "hook": "parseTaskResult",
      "args": [{}, { "code": 200, "data": { "status": "failed", "error": { "message": "content blocked" } } }, { "status": 200, "headers": {} }],
      "expected": { "status": "FAILURE", "progress": "100%", "reason": "content blocked" }
    },
    {
      "name": "unknown status is not in progress",
      "hook": "parseTaskResult",
      "args": [{}, { "code": 200, "data": { "status": "unexpected" } }, { "status": 200, "headers": {} }],
      "expected": { "status": "UNKNOWN", "reason": "unrecognized APIMart task status: unexpected" }
    },
    {
      "name": "settle on reported token usage",
      "hook": "extractUsageOnComplete",
      "args": [
        {},
        { "status": "SUCCESS" },
        { "code": 200, "data": { "status": "completed", "usage": { "input_tokens": 16, "output_tokens": 439, "total_tokens": 455 } } }
      ],
      "expected": { "input_tokens": 16, "output_tokens": 439 }
    }
  ]
}
